# Sarthi CPT Vector Service Environment Configuration
# Copy this file to .env.local and update values for your environment

# Environment
NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080

# Google Cloud Platform
GCP_PROJECT_ID=sarthi-healthcare-prod
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_KEY=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cpt_service
DB_PASSWORD=your_secure_password
DB_NAME=sarthi_cpt
DB_LOGGING=false
DB_SSL_CERT=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TTL=3600
REDIS_MAX_ITEMS=1000

# Firestore Configuration
FIRESTORE_PROJECT_ID=sarthi-healthcare-prod
FIRESTORE_COLLECTION=Vectorized_CPT_Test
FIRESTORE_VECTOR_FIELD=vector
FIRESTORE_CREDENTIALS_PATH=

# Vertex AI Configuration
VERTEX_PROJECT_ID=sarthi-healthcare-prod
VERTEX_LOCATION=us-central1
VERTEX_ENDPOINT_ID=
VERTEX_INDEX_ID=
EMBEDDING_MODEL=text-embedding-004
GENERATIVE_MODEL=gemini-2.0-flash-exp
EMBEDDING_DIMENSIONS=768

# Security Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your_encryption_key_here
KMS_KEY_RING=sarthi-phi
KMS_KEY=cpt-service-key
BCRYPT_ROUNDS=12

# HIPAA Compliance
HIPAA_COMPLIANCE_ENABLED=true
AUDIT_RETENTION_DAYS=2555
PHI_REDACTION_ENABLED=true
ENCRYPTION_AT_REST_ENABLED=true
DATA_RESIDENCY=us-central1

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# Monitoring and Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
TRACING_SAMPLE_RATE=0.1
LOG_LEVEL=info
CLOUD_LOGGING_ENABLED=true

# API Gateway Integration
API_GATEWAY_URL=
AUTH_SERVICE_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SERVICE_REGISTRATION_ENABLED=true

# Multi-Tenant Configuration
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=sarthi-main
TENANT_HEADER=X-Tenant-Id
TENANT_VALIDATION_ENABLED=true

# Vector Search Configuration
SIMILARITY_THRESHOLD=0.70
MAX_SEARCH_RESULTS=20
VECTOR_CACHE_ENABLED=true
VECTOR_CACHE_TTL=1800
VECTOR_BATCH_SIZE=32

# Performance Configuration
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
BODY_LIMIT=10mb
COMPRESSION_ENABLED=true
MAX_REQUEST_SIZE=10485760

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Development/Debug Options
AUTH_DISABLED=false
SECURITY_STRICT_MODE=false